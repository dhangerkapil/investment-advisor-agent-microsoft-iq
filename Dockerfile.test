# Validation image for ACR builds (no local Python packages needed):
#   az acr build --registry <acr> --file Dockerfile.test --no-push .
FROM ghcr.io/astral-sh/uv:0.13.1 AS uv
FROM python:3.14-slim
COPY --from=uv /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --extra dev --extra ui --no-install-project
COPY src ./src
COPY .agent_configs ./.agent_configs
COPY tests ./tests
# Deployment-script tests read scripts/ and the Terraform definitions (*.tf only; never state or tfvars).
COPY scripts ./scripts
COPY terraform ./terraform
# Story-date tests run the content date shifter and the Fabric notebook's data section.
COPY hydration ./hydration
COPY fabric ./fabric
# The quality-loop tests import the optimizer tooling (the leakage guard).
COPY evals ./evals
RUN uv sync --frozen --extra dev --extra ui
ENV PATH="/app/.venv/bin:$PATH" PYTHONUNBUFFERED=1
RUN python -m compileall -q src \
 && python -c "import workplace_agent.app, workplace_agent.advisor; print('imports ok')" \
 && python -m pytest -q tests/test_advisor.py
